{
  "name": "streamrip-ui",
  "version": "1.0.8",
  "private": true,
  "description": "A modern desktop GUI for streamrip — download hi-res music from Qobuz, TIDAL, Deezer & SoundCloud",
  "author": "netz-sg",
  "repository": {
    "type": "git",
    "url": "https://github.com/netz-sg/streamrip-ui.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "cd frontend && npm run build",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "release": "node ../scripts/release.js"
  },
  "build": {
    "appId": "com.streamrip.ui",
    "productName": "streamrip-ui",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": [
          "**/*",
          "!__pycache__/**"
        ]
      },
      {
        "from": "frontend/public/logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "frontend/public/logo.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "frontend/public/logo.png",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "wait-on": "^7.2.0"
  }
}
